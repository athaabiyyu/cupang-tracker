# Salin file ini menjadi .env.local lalu isi nilainya.

# Password untuk masuk ke aplikasi (WAJIB, ganti dengan yang kuat)
APP_PASSWORD=ganti-password-ini

# Connection string database Neon Postgres.
# - Di Vercel: terisi otomatis saat kamu menghubungkan Neon lewat tab Storage.
# - Di laptop: boleh dikosongkan, data disimpan ke file data/cupang.json.
DATABASE_URL=
